
SECRET_KEY=your-secret-key-here
ADMIN_EMAIL=admin@trek.com
ADMIN_PASSWORD=admin123

DATABASE_URL=sqlite:///database.db

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# Set USE_REAL_SMTP=true to send actual emails via SMTP.
# Leave as false to log emails locally to backend/logs/sent_emails.log.
USE_REAL_SMTP=false

# gmail SMTP example:
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=noreply@treksphere.app
SMTP_USERNAME=your-smpt-username
SMTP_PASSWORD=your-app-password-here
SMTP_USE_TLS=true
